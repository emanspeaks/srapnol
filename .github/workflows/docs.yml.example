name: docs

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # Full history: tools/add_edit_metadata.py reads per-file git log.
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install Doorstop and MkDocs
        run: pip install doorstop==3.2 mkdocs==1.6.1 pymdown-extensions==12.0
      - name: Validate requirement tree
        run: doorstop --no-reformat
      - name: Publish requirement tree
        run: doorstop publish all docs/build/req --markdown
      - name: Fix attr_list anchor links
        run: python tools/fix_anchors.py docs/build/req
      - name: Add per-item last-changed metadata from git
        run: python tools/add_edit_metadata.py docs/build/req
      - name: Build site
        run: mkdocs build
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: site

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
